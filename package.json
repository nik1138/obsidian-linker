{
  "name": "obsidian-linker",
  "version": "2.0.0",
  "description": "Node.js project for finding conceptual links in Obsidian vault using RAG",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "obsidian-linker": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "obsidian",
    "nlp",
    "markdown",
    "links",
    "conceptual",
    "rag",
    "lancedb",
    "embeddings"
  ],
  "author": "SourceCraft",
  "license": "MIT",
  "dependencies": {
    "@lancedb/lancedb": "^0.15.0",
    "@xenova/transformers": "^2.17.2",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "markdown-it": "^14.2.0",
    "onnxruntime-node": "^1.19.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^20.19.41",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
